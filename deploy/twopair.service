# systemd unit for the twopair trading loop.
# Install (as root):
#   cp deploy/twopair.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now twopair
# Logs: journalctl -u twopair -f
[Unit]
Description=twopair trading loop
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust to the deployment path and unix user.
User=twopair
WorkingDirectory=/opt/twopair
# Append run_live.py args here, e.g. --testnet or --config deploy/cfg.json
ExecStart=/opt/twopair/deploy/start.sh
Restart=always
RestartSec=30
# The loop is quiet by design; give it generous stop time to finish a cycle.
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
